<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MilLib.Desktop.ViewModels"
             xmlns:conv="using:MilLib.Desktop"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="MilLib.Desktop.Views.ReportsView"
             x:DataType="vm:ReportsViewModel">

    <Grid ColumnDefinitions="290,*">

        <!-- ================================================ which report ==== -->
        <Border Grid.Column="0" Classes="card" Padding="0" ClipToBounds="True" Margin="0,0,20,0">
            <Grid RowDefinitions="*,Auto">
                <!-- A list rather than a row of radio buttons: each report
                     carries a line saying what it is for, which is the
                     difference between picking one and guessing. -->
                <ListBox Grid.Row="0" Classes="table"
                         ItemsSource="{Binding Choices}"
                         SelectedItem="{Binding Chosen}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:ReportChoice">
                            <StackPanel>
                                <!-- The heading this report sits under, printed
                                     once above the first report of its section.
                                     Inside the row rather than a separate list
                                     so one ListBox still carries the whole
                                     thing and selection stays simple. -->
                                <TextBlock Text="{Binding SectionHeader}" Classes="label"
                                           Margin="18,14,18,4"
                                           IsVisible="{Binding StartsSection}" />

                                <StackPanel Spacing="3" Margin="18,7">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium"
                                                   VerticalAlignment="Center" />
                                        <Border Classes="pill warn" VerticalAlignment="Center"
                                                IsVisible="{Binding IsWatched}">
                                            <TextBlock Text="Recorded" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding About}" Classes="faint" FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Said once, at the foot of the list, rather than on every
                     report: it is true of all of them and it is not a warning,
                     it is how the reports work. -->
                <Border Grid.Row="1" Background="{DynamicResource GlassSunken}"
                        BorderBrush="{DynamicResource GlassEdge}" BorderThickness="0,1,0,0"
                        Padding="18,14">
                    <TextBlock Text="{Binding ClearedTo}" Classes="faint"
                               FontSize="11" TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>

        <!-- ==================================================== the report ==== -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{Binding Heading}" Classes="h2" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Note}" Classes="faint" TextWrapping="Wrap"
                               IsVisible="{Binding HasNote}" />
                    <TextBlock Text="{Binding Tally}" Classes="faint" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Top" Margin="14,0,0,0">
                    <Button Classes="primary withIcon" Content="PDF"
                            Tag="{StaticResource IconPrint}" MinHeight="40"
                            ToolTip.Tip="The whole report, to file"
                            IsEnabled="{Binding HasReport}"
                            Command="{Binding PdfCommand}" />
                    <Button Classes="quiet" Content="Spreadsheet" MinHeight="40"
                            ToolTip.Tip="The whole report, to work on"
                            IsEnabled="{Binding HasReport}"
                            Command="{Binding CsvCommand}" />
                </StackPanel>
            </Grid>

            <!-- What this report needs telling. Only shown for the ones that
                 need anything, so five of the six open with no questions. -->
            <Border Grid.Row="1" Classes="card" Padding="18,14" Margin="0,0,0,14"
                    IsVisible="{Binding NeedsAnything}">
                <StackPanel Orientation="Horizontal" Spacing="12">

                    <StackPanel Orientation="Horizontal" Spacing="10"
                                IsVisible="{Binding NeedsMember}">
                        <TextBlock Text="Member" Classes="faint" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Member, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Membership number or name"
                                 MinHeight="38" MinWidth="280" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10"
                                IsVisible="{Binding NeedsGrouping}">
                        <TextBlock Text="Grouped by" Classes="faint" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding Groupings}" SelectedItem="{Binding By}"
                                  MinHeight="38" MinWidth="200">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static conv:Spoken.Instance}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10"
                                IsVisible="{Binding NeedsDates}">
                        <TextBlock Text="From" Classes="faint" VerticalAlignment="Center" />
                        <CalendarDatePicker SelectedDate="{Binding From}" MinHeight="38" MinWidth="170" />
                        <TextBlock Text="to" Classes="faint" VerticalAlignment="Center" />
                        <CalendarDatePicker SelectedDate="{Binding To}" MinHeight="38" MinWidth="170" />
                    </StackPanel>

                    <Button Content="Run it" Classes="primary" MinHeight="38"
                            IsEnabled="{Binding !Busy}"
                            Command="{Binding RunCommand}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Classes="card bad" IsVisible="{Binding HasProblem}"
                    VerticalAlignment="Top" Padding="18,14">
                <TextBlock Text="{Binding Problem}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Bad}" />
            </Border>

            <!-- The table is built in code, because a report's columns are not
                 known until it has run — there are between two and seven of
                 them and they differ per report. -->
            <Border Grid.Row="2" Classes="card" Padding="0" ClipToBounds="True"
                    IsVisible="{Binding !HasProblem}">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Classes="tableHead">
                        <Grid Name="HeadingRow" Margin="20,0" />
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Name="Body" Classes="rows" />
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" IsVisible="{Binding Nothing}"
                                VerticalAlignment="Center" Spacing="8">
                        <TextBlock Text="Nothing to report" Classes="h2" HorizontalAlignment="Center" />
                        <TextBlock Classes="faint" HorizontalAlignment="Center" TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Text="Which, for most of these, is the answer you want." />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
