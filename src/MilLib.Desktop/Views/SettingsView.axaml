<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MilLib.Desktop.ViewModels"
             xmlns:conv="using:MilLib.Desktop"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="MilLib.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- What was just saved, above everything, because a save on this
             screen changes what other screens will show. -->
        <Border Grid.Row="0" Classes="card" Margin="0,0,0,14" Padding="16,12"
                IsVisible="{Binding HasSaid}"
                Background="{Binding SaidIsGood, Converter={x:Static conv:Swatch.GoodOrBad}}">
            <TextBlock Text="{Binding Said}" TextWrapping="Wrap"
                       Foreground="{Binding SaidIsGood, Converter={x:Static conv:Swatch.GoodOrBadInk}}" />
        </Border>

        <Border Grid.Row="1" Classes="card bad" Margin="0,0,0,14" Padding="18,14"
                IsVisible="{Binding HasProblem}">
            <TextBlock Text="{Binding Problem}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Bad}" />
        </Border>

        <!-- One screen, four cards, no scroll.

             Branding is the wide card across the top — the unit's identity on
             the left, how it looks on the right, saved as one. Numbering and
             labels sit beneath it, and the screens-on-off list runs full height
             down the side, saving each tick as it is made. Everything a unit
             sets up on the day it is installed is in view at once. -->
        <Grid Grid.Row="2" ColumnDefinitions="*,14,*,16,340"
              RowDefinitions="Auto,14,*" IsVisible="{Binding !HasProblem}">

            <!-- ==================================================== branding -->
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                    Classes="card" Padding="18,15">
                <StackPanel Spacing="13">
                    <TextBlock Text="Branding" Classes="h2" />

                    <Grid ColumnDefinitions="1.02*,18,1*">

                        <!-- the unit's identity -->
                        <Grid Grid.Column="0" ColumnDefinitions="Auto,14,*">
                            <StackPanel Grid.Column="0" Spacing="6" Width="104">
                                <Border Width="104" Height="104" CornerRadius="8"
                                        Background="{DynamicResource Glass}"
                                        BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                    <Panel>
                                        <TextBlock Text="No crest" Classes="faint" FontSize="11"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   IsVisible="{Binding Crest, Converter={x:Static ObjectConverters.IsNull}}" />
                                        <Image Source="{Binding Crest}" Margin="9" Stretch="Uniform"
                                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                                    </Panel>
                                </Border>

                                <Button Content="Choose…" HorizontalAlignment="Stretch" MinHeight="32"
                                        IsEnabled="{Binding MayManage}"
                                        Command="{Binding ChooseCrestCommand}" />
                                <Button Content="Remove" Classes="quiet" HorizontalAlignment="Stretch"
                                        MinHeight="28"
                                        IsEnabled="{Binding MayManage}"
                                        Command="{Binding RemoveCrestCommand}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="9">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Library name" Classes="faint" />
                                    <TextBox Text="{Binding LibraryName, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="38" IsEnabled="{Binding MayManage}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Organisation" Classes="faint" />
                                    <TextBox Text="{Binding Organisation, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="38" IsEnabled="{Binding MayManage}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Motto" Classes="faint" />
                                    <TextBox Text="{Binding Motto, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="38" IsEnabled="{Binding MayManage}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- how it looks: the two colours and the bar -->
                        <StackPanel Grid.Column="2" Spacing="10">

                            <Grid ColumnDefinitions="*,12,Auto">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="Accent colour" Classes="faint" />
                                    <Grid ColumnDefinitions="Auto,8,*">
                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="6"
                                                BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                Background="{Binding AccentBrush}" />
                                        <TextBox Grid.Column="2" Classes="mono" MinHeight="38"
                                                 Text="{Binding Accent, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding MayManage}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Palettes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Padding="0" Margin="0,0,5,5"
                                                        Background="Transparent" BorderThickness="0"
                                                        ToolTip.Tip="{Binding Name}"
                                                        Command="{Binding ChooseCommand}">
                                                    <Border Width="22" Height="22" CornerRadius="4"
                                                            Background="{Binding Swatch}"
                                                            BorderBrush="{DynamicResource Line}" BorderThickness="1" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="6" Width="118">
                                    <TextBlock Text="Crest circle" Classes="faint" />
                                    <Grid ColumnDefinitions="Auto,8,*">
                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                                                BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                Background="{Binding CircleBrush}" />
                                        <TextBox Grid.Column="2" Classes="mono" MinHeight="38" FontSize="12"
                                                 Text="{Binding CrestCircleColour, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding MayManage}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Top bar colour" Classes="faint" />
                                <Grid ColumnDefinitions="Auto,8,*,12,Auto">
                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="6"
                                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                            Background="{Binding BarBrush}" />
                                    <TextBox Grid.Column="2" Classes="mono" MinHeight="38"
                                             Text="{Binding BarColour, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding MayManage}" />

                                    <!-- The strip as it will look, in miniature, right
                                         beside the box so the colour is judged by eye. -->
                                    <Border Grid.Column="4" CornerRadius="5" ClipToBounds="True" Width="150"
                                            BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                        <StackPanel Background="{Binding BarBrush}">
                                            <Grid ColumnDefinitions="*,Auto" Margin="9,6">
                                                <TextBlock Grid.Column="0" Text="{Binding LibraryName}"
                                                           FontWeight="Bold" FontSize="10" Foreground="#F2F2F2"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="20:25" FontWeight="SemiBold"
                                                           FontSize="12" Foreground="#F4F4F4"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                            <Rectangle Height="2.5" Fill="{Binding AccentBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding BarPalettes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Padding="0" Margin="0,0,5,5"
                                                    Background="Transparent" BorderThickness="0"
                                                    ToolTip.Tip="{Binding Name}"
                                                    Command="{Binding ChooseCommand}">
                                                <Border Width="22" Height="22" CornerRadius="4"
                                                        Background="{Binding Swatch}"
                                                        BorderBrush="{DynamicResource Line}" BorderThickness="1" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="20">
                                <CheckBox Content="Crest in a circle"
                                          IsChecked="{Binding CrestInCircle}"
                                          IsEnabled="{Binding MayManage}" />
                                <CheckBox Content="Open in the dark theme"
                                          IsChecked="{Binding DarkByDefault}"
                                          IsEnabled="{Binding MayManage}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*">
                        <Button Grid.Column="0" Classes="primary" Content="Save the branding"
                                MinHeight="40" MinWidth="170"
                                IsEnabled="{Binding MayManage}"
                                Command="{Binding SaveBrandingCommand}" />
                        <TextBlock Grid.Column="1" Text="{Binding CrestNote}" Classes="faint" FontSize="11"
                                   VerticalAlignment="Center" Margin="16,0,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- =================================================== accession -->
            <Border Grid.Row="2" Grid.Column="0" Classes="card" Padding="18,15"
                    VerticalAlignment="Top">
                <StackPanel Spacing="12">
                    <TextBlock Text="How books are numbered" Classes="h2" />

                    <Grid ColumnDefinitions="*,12,Auto,12,Auto">
                        <StackPanel Grid.Column="0" Spacing="5">
                            <TextBlock Text="Prefix" Classes="faint" />
                            <TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}"
                                     Classes="mono" MinHeight="38" IsEnabled="{Binding MayManage}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="5" Width="96">
                            <TextBlock Text="Digits" Classes="faint" />
                            <NumericUpDown Value="{Binding PadLength}" Minimum="1" Maximum="12"
                                           FormatString="0" MinHeight="38" IsEnabled="{Binding MayManage}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Spacing="5" Width="128">
                            <TextBlock Text="Start from" Classes="faint" />
                            <NumericUpDown Value="{Binding StartFrom}" Minimum="1" Maximum="99999999"
                                           FormatString="0" MinHeight="38" IsEnabled="{Binding MayChangeStart}" />
                        </StackPanel>
                    </Grid>

                    <CheckBox Content="Show the prefix on screens and labels"
                              IsChecked="{Binding ShowPrefix}" IsEnabled="{Binding MayManage}" />

                    <Border Classes="card cool" Padding="14,10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Text="A NUMBER WILL LOOK LIKE" Classes="label" />
                                <TextBlock Text="{Binding SampleNumber}" Classes="mono" FontSize="18" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="NEXT TO BE GIVEN" Classes="label" TextAlignment="Right" />
                                <TextBlock Text="{Binding NextNumber}" Classes="mono" TextAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Classes="faint" FontSize="11" TextWrapping="Wrap"
                               Text="{Binding LockNote}" />

                    <Button Classes="primary" Content="Save the numbering" MinHeight="40"
                            HorizontalAlignment="Left" MinWidth="170"
                            IsEnabled="{Binding MayManage}"
                            Command="{Binding SaveAccessionCommand}" />
                </StackPanel>
            </Border>

            <!-- ====================================================== labels -->
            <Border Grid.Row="2" Grid.Column="2" Classes="card" Padding="18,15"
                    VerticalAlignment="Top">
                <StackPanel Spacing="12">
                    <TextBlock Text="Label stock" Classes="h2" />

                    <Grid ColumnDefinitions="*,10,*,10,*,10,*">
                        <StackPanel Grid.Column="0" Spacing="5">
                            <TextBlock Text="Pkt W" Classes="faint" />
                            <NumericUpDown Value="{Binding PocketWidth}" Minimum="5" Maximum="300"
                                           Increment="0.5" FormatString="0.##" MinHeight="38"
                                           IsEnabled="{Binding MayManage}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="5">
                            <TextBlock Text="Pkt H" Classes="faint" />
                            <NumericUpDown Value="{Binding PocketHeight}" Minimum="5" Maximum="300"
                                           Increment="0.5" FormatString="0.##" MinHeight="38"
                                           IsEnabled="{Binding MayManage}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Spacing="5">
                            <TextBlock Text="Spine W" Classes="faint" />
                            <NumericUpDown Value="{Binding SpineWidth}" Minimum="5" Maximum="300"
                                           Increment="0.5" FormatString="0.##" MinHeight="38"
                                           IsEnabled="{Binding MayManage}" />
                        </StackPanel>
                        <StackPanel Grid.Column="6" Spacing="5">
                            <TextBlock Text="Spine H" Classes="faint" />
                            <NumericUpDown Value="{Binding SpineHeight}" Minimum="5" Maximum="300"
                                           Increment="0.5" FormatString="0.##" MinHeight="38"
                                           IsEnabled="{Binding MayManage}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="5">
                        <TextBlock Text="What goes on a pocket label" Classes="faint" />
                        <ComboBox ItemsSource="{Binding Codes}"
                                  SelectedItem="{Binding ChosenCode}"
                                  MinHeight="38" HorizontalAlignment="Stretch"
                                  IsEnabled="{Binding MayManage}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="vm:CodeChoice">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <CheckBox Content="One label per page (a label printer), not a sheet"
                              IsChecked="{Binding OneLabelPerPage}" IsEnabled="{Binding MayManage}" />
                    <CheckBox Content="The thermal printer is 300 dpi (most are 203)"
                              IsChecked="{Binding FinePrinter}" IsEnabled="{Binding MayManage}" />

                    <Button Classes="primary" Content="Save the label sizes" MinHeight="40"
                            HorizontalAlignment="Left" MinWidth="170"
                            IsEnabled="{Binding MayManage}"
                            Command="{Binding SaveLabelsCommand}" />
                </StackPanel>
            </Border>

            <!-- ================================================ feature flags -->
            <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="4"
                    Classes="card" Padding="0" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Spacing="3" Margin="18,15,18,10">
                        <TextBlock Text="Which screens this library has" Classes="h2" />
                        <TextBlock Classes="sub" Text="Each saves the moment you tick it." />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Features}" Margin="18,0,18,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:FeatureRow">
                                    <Grid Margin="0,5" ColumnDefinitions="*,Auto"
                                          ToolTip.Tip="{Binding What}">
                                        <CheckBox Grid.Column="0" Content="{Binding Name}"
                                                  IsChecked="{Binding On}"
                                                  Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).ToggleFeatureCommand}"
                                                  CommandParameter="{Binding}" />
                                        <TextBlock Grid.Column="1" Text="no screen yet" Classes="faint"
                                                   FontSize="10" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Bad}"
                                                   IsVisible="{Binding Unavailable}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- The single most misunderstood thing about this screen:
                         turning a feature off hides a screen and keeps every
                         record it ever made. -->
                    <Border Grid.Row="2" Classes="card cool" Margin="14" Padding="13,11">
                        <TextBlock TextWrapping="Wrap" FontSize="11"
                                   Text="Turning one off hides its screen. Nothing is deleted — every record it kept stays, and turning it back on shows them again." />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
