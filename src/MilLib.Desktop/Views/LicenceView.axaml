<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MilLib.Desktop.ViewModels"
             xmlns:conv="using:MilLib.Desktop"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
             x:Class="MilLib.Desktop.Views.LicenceView"
             x:DataType="vm:LicenceViewModel">

    <UserControl.Styles>
        <!-- The term bar: a loading bar, rounded, the fill a gradient of the
             unit's accent (or red when the term is running out), on a sunken
             track. It reads at a glance as "this much time is left". -->
        <Style Selector="ProgressBar.term">
            <Setter Property="Height" Value="16" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
        </Style>
        <Style Selector="ProgressBar.term /template/ Border#PART_Indicator">
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- A small state badge — TRIAL, LICENSED, EXPIRED — that reads as a
             status chip rather than a word. -->
        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.badge TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1.5" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MaxWidth="1180" HorizontalAlignment="Stretch">

            <!-- ============================================ where this stands -->
            <Border Classes="card" Padding="28,24"
                    Background="{Binding Grave, Converter={x:Static conv:Swatch.BadOrGoodSoft}}"
                    BorderBrush="{Binding Grave, Converter={x:Static conv:Swatch.BadOrGood}}">
                <StackPanel Spacing="18">

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="{Binding Headline}" FontSize="24" FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Foreground="{Binding Grave, Converter={x:Static conv:Swatch.BadOrGood}}" />
                            <TextBlock Text="{Binding What}" TextWrapping="Wrap" FontSize="13"
                                       MaxWidth="760" HorizontalAlignment="Left"
                                       IsVisible="{Binding What, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>

                        <Border Grid.Column="1" Classes="badge"
                                Background="{Binding Grave, Converter={x:Static conv:Swatch.BadOrGood}}">
                            <TextBlock Text="{Binding StateBadge}" Foreground="#FFFFFF" />
                        </Border>
                    </Grid>

                    <!-- the term, drawn -->
                    <StackPanel Spacing="8" IsVisible="{Binding ShowTerm}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding TermLabel}" Classes="label" />
                            <TextBlock Grid.Column="1" Text="{Binding TermValue}"
                                       FontWeight="SemiBold" FontSize="12.5"
                                       Foreground="{Binding Grave, Converter={x:Static conv:Swatch.BadOrGood}}" />
                        </Grid>

                        <ProgressBar Classes="term" Value="{Binding TermFraction}"
                                     Foreground="{Binding Grave, Converter={x:Static conv:Swatch.BadOrGood}}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding TermStart}" Classes="faint" FontSize="11" />
                            <TextBlock Grid.Column="1" Text="{Binding TermEnd}" Classes="faint" FontSize="11" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============================ two even columns: activate, and ask -->
            <Grid ColumnDefinitions="*,16,*">

                <!-- activate this machine -->
                <Border Grid.Column="0" Classes="card" Padding="26,22" VerticalAlignment="Stretch">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Activate this machine" Classes="h2" />
                            <TextBlock Classes="sub" TextWrapping="Wrap"
                                       Text="A key is issued against this machine and works on no other. Send the hardware ID; type the key that comes back." />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="THIS MACHINE" Classes="label" />
                            <SelectableTextBlock Text="{Binding HardwareId}" Classes="mono" FontSize="20" />
                            <TextBlock Text="{Binding MachineSource}" Classes="faint" FontSize="11"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Classes="card cool" Padding="16,13">
                            <StackPanel Spacing="9">
                                <TextBlock Text="WHAT TO SEND" Classes="label" />
                                <SelectableTextBlock Text="{Binding ToSend}" Classes="mono"
                                                     FontSize="11.5" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Copy this" MinHeight="36"
                                            Command="{Binding CopyDetailsCommand}" />
                                    <TextBlock Text="Copied." Classes="faint" VerticalAlignment="Center"
                                               IsVisible="{Binding Copied}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Rectangle Height="1" Fill="{DynamicResource Line}" />

                        <StackPanel Spacing="8" IsVisible="{Binding MayActivate}">
                            <TextBlock Text="THE LICENCE KEY" Classes="label" />
                            <TextBox Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="XXXXX-XXXXX-XXXXX-XXXXX-XXXXX-NNNNNN"
                                     Classes="mono" FontSize="16" MinHeight="46" Padding="14,9">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding ActivateCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <TextBlock Classes="faint" FontSize="11" TextWrapping="Wrap"
                                       Text="Dashes and capitals do not matter. There is no letter O or I in a key — those are a zero and a one." />

                            <Border Classes="card" Padding="16,12"
                                    IsVisible="{Binding HasSaid}"
                                    Background="{Binding SaidIsGood, Converter={x:Static conv:Swatch.GoodOrBad}}">
                                <TextBlock Text="{Binding Said}" TextWrapping="Wrap"
                                           Foreground="{Binding SaidIsGood, Converter={x:Static conv:Swatch.GoodOrBadInk}}" />
                            </Border>

                            <Button Classes="primary" Content="Activate" MinHeight="44"
                                    MinWidth="160" HorizontalAlignment="Left"
                                    IsEnabled="{Binding !Busy}"
                                    Command="{Binding ActivateCommand}" />
                        </StackPanel>

                        <StackPanel Spacing="6" IsVisible="{Binding Licensed}">
                            <TextBlock Text="THE KEY ON THIS MACHINE" Classes="label" />
                            <SelectableTextBlock Text="{Binding CurrentKey}" Classes="mono" FontSize="12.5" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- who to ask -->
                <Border Grid.Column="2" Classes="card" Padding="26,22" VerticalAlignment="Stretch">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Who to ask" Classes="h2" />
                            <TextBlock Text="{Binding Product}" Classes="faint" FontSize="11.5" />
                        </StackPanel>

                        <StackPanel Spacing="13">
                            <StackPanel Spacing="2">
                                <TextBlock Text="COMPANY" Classes="label" />
                                <TextBlock Text="{Binding Company}" FontWeight="Medium" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Text="TELEPHONE" Classes="label" />
                                <SelectableTextBlock Text="{Binding Phone}" Classes="mono" FontSize="12.5" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Text="EMAIL" Classes="label" />
                                <SelectableTextBlock Text="{Binding Email}" FontSize="12.5" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Text="WHERE" Classes="label" />
                                <TextBlock Text="{Binding Address}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Text="ONLINE" Classes="label" />
                                <SelectableTextBlock Text="{Binding Website}" FontSize="12.5" />
                            </StackPanel>
                        </StackPanel>

                        <Rectangle Height="1" Fill="{DynamicResource Line}" />

                        <Border Classes="card cool" Padding="14,12">
                            <TextBlock TextWrapping="Wrap" FontSize="11.5"
                                       Text="A licence controls whether the application opens. It has nothing to do with the records themselves — every book, member and loan stays exactly where it is, and entering a key puts everything back as it was." />
                        </Border>

                        <Button Content="Check again" Classes="quiet" MinHeight="38"
                                HorizontalAlignment="Left"
                                Command="{Binding RefreshCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
