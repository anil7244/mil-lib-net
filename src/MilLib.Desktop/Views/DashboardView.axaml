<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MilLib.Desktop.ViewModels"
             xmlns:conv="using:MilLib.Desktop"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="MilLib.Desktop.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Who, and when. One line, and then out of the way. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Text="{Binding Greeting}" Classes="h2" />
                <TextBlock Text="{Binding Standing}" Classes="faint" />
            </StackPanel>

            <Button Grid.Column="1" Classes="quiet"
                    Content="Refresh"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}" />
        </Grid>

        <Border Grid.Row="0" Classes="card bad" IsVisible="{Binding HasProblem}" Padding="18,14">
            <TextBlock Text="{Binding Problem}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Bad}" />
        </Border>

        <!--
             The figures.

             Six, in the order a librarian would ask for them: what we have,
             what is out, what is late, who we lend to. Each one is tinted for
             what kind of figure it is, so the row can be read by colour before
             it is read by word — and the one that means trouble is the only red
             thing on the screen.
        -->
        <!--
             The figures.

             Built from the view model, because which ones appear depends on
             what this person may see and what the unit has switched on. Each is
             a card that is also a way in: the number is the button, and clicking
             the figure walks to the screen it is about. Those that are running
             totals rather than screens of their own are plain.
        -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Stats}" Margin="0,0,0,22">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:StatCard">
                    <Border Classes="card tile" Margin="5" Padding="20"
                            Classes.cool="{Binding IsCool}"
                            Classes.info="{Binding IsInfo}"
                            Classes.good="{Binding IsGood}"
                            Classes.warn="{Binding IsWarn}"
                            Classes.bad="{Binding IsBad}"
                            Classes.open="{Binding CanOpen}"
                            Tapped="OnStatTapped">
                        <StackPanel Spacing="5">
                            <TextBlock Text="{Binding Label}" Classes="label" />
                            <TextBlock Text="{Binding Value}" Classes="figure"
                                       Foreground="{Binding IsBad, Converter={x:Static conv:Swatch.BadOrPlain}}" />
                            <TextBlock Text="{Binding Note}" Classes="faint" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--
             What should have come back and hasn't.

             The only list on this screen, because it is the only one that asks
             somebody to do something today. Oldest first — the book that is
             three months late matters more than the one that is a day late.
        -->
        <Border Grid.Row="2" Classes="card" Padding="0" ClipToBounds="True">
            <Grid RowDefinitions="Auto,*">

                <Border Grid.Row="0" Classes="tableHead">
                    <Grid ColumnDefinitions="*,2*,150,110,90" Margin="20,0">
                        <TextBlock Grid.Column="0" Text="MEMBER" Classes="label" />
                        <TextBlock Grid.Column="1" Text="BOOK" Classes="label" />
                        <TextBlock Grid.Column="2" Text="ACCESSION NO" Classes="label" />
                        <TextBlock Grid.Column="3" Text="DUE" Classes="label" />
                        <TextBlock Grid.Column="4" Text="LATE BY" Classes="label" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Overdues}" Classes="rows">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:OverdueRow">
                                    <Grid ColumnDefinitions="*,2*,150,110,90" Margin="20,11">
                                        <TextBlock Grid.Column="0" Text="{Binding Member}"
                                                   FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Book}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Accession}" Classes="mono" />
                                        <TextBlock Grid.Column="3" Text="{Binding DueText}" Classes="faint" />
                                        <TextBlock Grid.Column="4" Text="{Binding DaysText}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Bad}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- A library with nothing overdue is a library doing
                             well, and should be told so rather than shown an
                             empty rectangle. -->
                        <StackPanel IsVisible="{Binding NothingOverdue}"
                                    Margin="0,54" Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="Nothing is overdue" Classes="h2"
                                       HorizontalAlignment="Center" />
                            <TextBlock Classes="faint" HorizontalAlignment="Center"
                                       Text="Every book that is out is still within its loan period." />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
