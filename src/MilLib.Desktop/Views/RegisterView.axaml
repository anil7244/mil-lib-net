<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MilLib.Desktop.ViewModels"
             xmlns:conv="using:MilLib.Desktop"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="MilLib.Desktop.Views.RegisterView"
             x:DataType="vm:RegisterViewModel">

    <Grid RowDefinitions="Auto,Auto,*">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
            <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Text="Every book the library has taken on" Classes="h2" />
                <TextBlock Classes="sub" TextWrapping="Wrap"
                           Text="In the order the numbers were handed out. Nothing on this screen can be edited — a correction is a note against the copy, written on the book's own screen." />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Top" Margin="14,0,0,0">
                <Button Classes="primary withIcon" Content="Save as PDF"
                        Tag="{StaticResource IconPrint}" MinHeight="42"
                        ToolTip.Tip="Writes the range shown to a PDF"
                        IsEnabled="{Binding !Busy}"
                        Command="{Binding PrintCommand}" />
            </StackPanel>
        </Grid>

        <!-- The range. Two numbers, because the question asked of a register is
             almost always "show me pages 400 to 500" — and printing fourteen
             hundred entries to see twenty is not an answer. -->
        <Border Grid.Row="1" Classes="card" Padding="18,14" Margin="0,0,0,14">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*">
                    <TextBlock Grid.Column="0" Text="From" Classes="faint"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" Text="{Binding From, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="first"
                             MinHeight="38" Width="120" Classes="mono" />

                    <TextBlock Grid.Column="2" Text="to" Classes="faint"
                               VerticalAlignment="Center" Margin="12,0,8,0" />
                    <TextBox Grid.Column="3" Text="{Binding To, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="last"
                             MinHeight="38" Width="120" Classes="mono" />

                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0">
                        <Button Content="Show" Classes="primary" MinHeight="38"
                                Command="{Binding RefreshCommand}" />
                        <Button Content="Whole register" MinHeight="38"
                                Command="{Binding WholeRegisterCommand}" />
                    </StackPanel>

                    <TextBlock Grid.Column="5" Text="{Binding Tally}" Classes="faint"
                               VerticalAlignment="Center" Margin="20,0,0,0"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <TextBlock Text="{Binding Extent}" Classes="faint" FontSize="11" />

                <Border Classes="card" Padding="14,11"
                        IsVisible="{Binding HasSaid}"
                        Background="{Binding SaidIsGood, Converter={x:Static conv:Swatch.GoodOrBad}}">
                    <TextBlock Text="{Binding Said}" TextWrapping="Wrap"
                               Foreground="{Binding SaidIsGood, Converter={x:Static conv:Swatch.GoodOrBadInk}}" />
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Classes="card bad" IsVisible="{Binding HasProblem}"
                VerticalAlignment="Top" Padding="18,14">
            <TextBlock Text="{Binding Problem}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Bad}" />
        </Border>

        <!-- Ruled like the ledger it stands in for, and in the same column
             order, so somebody comparing the screen against the bound book is
             reading the same line twice rather than translating. -->
        <Border Grid.Row="2" Classes="card" Padding="0" ClipToBounds="True"
                IsVisible="{Binding !HasProblem}">
            <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0" Classes="tableHead">
                    <Grid ColumnDefinitions="130,90,90,2*,3*,110,80,90" Margin="20,0">
                        <TextBlock Grid.Column="0" Text="ACCESSION NO" Classes="label" />
                        <TextBlock Grid.Column="1" Text="BOOK NO" Classes="label" />
                        <TextBlock Grid.Column="2" Text="DATE" Classes="label" />
                        <TextBlock Grid.Column="3" Text="AUTHOR" Classes="label" />
                        <TextBlock Grid.Column="4" Text="TITLE" Classes="label" />
                        <TextBlock Grid.Column="5" Text="SOURCE" Classes="label" />
                        <TextBlock Grid.Column="6" Text="COST" Classes="label" />
                        <TextBlock Grid.Column="7" Text="REMARKS" Classes="label" />
                    </Grid>
                </Border>

                <ListBox Grid.Row="1" Classes="table"
                         ItemsSource="{Binding Lines}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:RegisterLine">
                            <Grid ColumnDefinitions="130,90,90,2*,3*,110,80,90" Margin="20,8">
                                <TextBlock Grid.Column="0" Text="{Binding Accession}" Classes="mono"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding BookNo}" Classes="mono"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Date}" Classes="mono"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Author}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4" Text="{Binding Title}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="5" Text="{Binding Source}" Classes="faint"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="6" Text="{Binding Cost}" Classes="mono"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="7" Text="{Binding Remarks}"
                                           VerticalAlignment="Center"
                                           FontWeight="Medium"
                                           IsVisible="{Binding HasRemark}"
                                           Foreground="{DynamicResource Bad}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1" IsVisible="{Binding Nothing}"
                            VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="Nothing in that range" Classes="h2" HorizontalAlignment="Center" />
                    <TextBlock Classes="faint" HorizontalAlignment="Center"
                               Text="Clear the two boxes to see the whole register." />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
