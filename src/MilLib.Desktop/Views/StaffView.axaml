<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MilLib.Desktop.ViewModels"
             xmlns:conv="using:MilLib.Desktop"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="MilLib.Desktop.Views.StaffView"
             x:DataType="vm:StaffViewModel">

    <Grid ColumnDefinitions="*,440">

        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" Margin="0,0,20,0">

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="Who may sign in" Classes="h2" />
                    <TextBlock Classes="sub" TextWrapping="Wrap"
                               Text="An account is never deleted — suspending one takes away the sign-in and leaves that person's name against everything they did." />
                </StackPanel>

                <Button Grid.Column="1" Classes="primary withIcon" Content="New account"
                        Tag="{StaticResource IconAdd}" MinHeight="42"
                        VerticalAlignment="Top" Margin="14,0,0,0"
                        IsVisible="{Binding MayManage}"
                        Command="{Binding AddCommand}" />
            </Grid>

            <Border Grid.Row="1" Classes="card" Margin="0,0,0,14" Padding="16,12"
                    IsVisible="{Binding HasSaid}"
                    Background="{Binding SaidIsGood, Converter={x:Static conv:Swatch.GoodOrBad}}">
                <TextBlock Text="{Binding Said}" TextWrapping="Wrap"
                           Foreground="{Binding SaidIsGood, Converter={x:Static conv:Swatch.GoodOrBadInk}}" />
            </Border>

            <Border Grid.Row="2" Classes="card bad" IsVisible="{Binding HasProblem}"
                    VerticalAlignment="Top" Padding="18,14">
                <TextBlock Text="{Binding Problem}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Bad}" />
            </Border>

            <Border Grid.Row="2" Classes="card" Padding="0" ClipToBounds="True"
                    IsVisible="{Binding !HasProblem}">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Classes="tableHead">
                        <!-- Two fixed columns beside a star one. The name is what
                             anybody reads down; the username and when they last
                             signed in go under it, where there is room. -->
                        <Grid ColumnDefinitions="*,152,116" Margin="20,0">
                            <TextBlock Grid.Column="0" Text="NAME" Classes="label" />
                            <TextBlock Grid.Column="1" Text="ROLE" Classes="label" />
                            <TextBlock Grid.Column="2" Text="CLEARED TO" Classes="label" />
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1" Classes="table"
                             ItemsSource="{Binding People}"
                             SelectedItem="{Binding Selected}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:PersonRow">
                                <Grid ColumnDefinitions="*,152,116" Margin="20,11">
                                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,14,0">
                                        <!-- A Grid, not a horizontal StackPanel.
                                             A StackPanel hands the name all the
                                             width it asks for and pushes the
                                             badges out of the column and over
                                             the role beside it, which is what a
                                             long name did. Here the badges take
                                             what they need and the name trims
                                             into whatever is left. -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                       FontWeight="Medium" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        Spacing="6" Margin="8,0,0,0">
                                                <Border Classes="pill info" VerticalAlignment="Center"
                                                        IsVisible="{Binding IsYou}">
                                                    <TextBlock Text="You" />
                                                </Border>
                                                <Border Classes="pill bad" VerticalAlignment="Center"
                                                        IsVisible="{Binding IsSuspended}">
                                                    <TextBlock Text="Suspended" />
                                                </Border>
                                                <Border Classes="pill warn" VerticalAlignment="Center"
                                                        IsVisible="{Binding IsStale}">
                                                    <TextBlock Text="Unused" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Trimmed as well. Without it the line
                                             was cut off mid-character and read
                                             "signed in today at 12:2". -->
                                        <TextBlock Text="{Binding Standing}" Classes="faint" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding Role}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Clearance}"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding IsCleared, Converter={x:Static conv:Swatch.BadOrPlain}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================= the editor ==== -->
        <Border Grid.Column="1" Classes="card" Padding="0" ClipToBounds="True">
          <Panel>

            <StackPanel VerticalAlignment="Center" Spacing="8" Margin="30"
                        IsVisible="{Binding !Editing}">
                <Path Classes="icon big" Data="{StaticResource IconUsers}"
                      Stroke="{DynamicResource InkFaint}" HorizontalAlignment="Center" />
                <TextBlock Text="Pick an account, or make one" Classes="sub" TextAlignment="Center" />
                <TextBlock Classes="faint" TextAlignment="Center" TextWrapping="Wrap"
                           Text="Keep as few Super Administrators as the unit can manage with — and always more than one." />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding Editing}">
                <StackPanel Margin="24,22,24,24" Spacing="18">

                    <TextBlock Text="{Binding EditHeading}" Classes="h2" TextWrapping="Wrap" />

                    <Border Classes="card" Padding="16,13"
                            IsVisible="{Binding HasProblems}"
                            Background="{DynamicResource BadSoft}"
                            BorderBrush="{DynamicResource Bad}">
                        <ItemsControl ItemsSource="{Binding Problems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"
                                               Foreground="{DynamicResource Bad}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Name" Classes="faint" />
                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="40" IsEnabled="{Binding MayManage}" />
                        <TextBlock Classes="faint" FontSize="11" TextWrapping="Wrap"
                                   Text="This is what appears against every loan they issue and every entry they make." />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Username" Classes="faint" />
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Classes="mono" MinHeight="40" IsEnabled="{Binding MayManage}" />
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding IsNew}">
                        <TextBlock Text="Password" Classes="faint" />
                        <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"
                                 PasswordChar="•" MinHeight="40" />
                        <TextBlock Classes="faint" FontSize="11" TextWrapping="Wrap"
                                   Text="At least eight characters. Tell them in person — there is no mail on this network." />
                    </StackPanel>

                    <Rectangle Height="1" Fill="{DynamicResource Line}" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="Role" Classes="faint" />
                        <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}"
                                  MinHeight="40" HorizontalAlignment="Stretch"
                                  IsEnabled="{Binding MayChangeRole}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static conv:Spoken.Instance}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="{Binding RoleLock}" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource Bad}"
                                   IsVisible="{Binding RoleIsLocked}" />

                        <Border Classes="card cool" Padding="12,10">
                            <TextBlock Text="{Binding RoleAllows}" TextWrapping="Wrap" FontSize="11" />
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Cleared up to" Classes="faint" />
                        <ComboBox ItemsSource="{Binding Clearances}" SelectedItem="{Binding Clearance}"
                                  MinHeight="40" HorizontalAlignment="Stretch"
                                  IsEnabled="{Binding MayManage}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static conv:Spoken.Instance}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Classes="faint" FontSize="11" TextWrapping="Wrap"
                                   Text="A ceiling on what they may see and issue. A book above it is refused outright." />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <CheckBox Content="May sign in" IsChecked="{Binding Active}"
                                  IsEnabled="{Binding MayChangeActive}" />
                        <TextBlock Text="{Binding ActiveLock}" TextWrapping="Wrap" FontSize="11"
                                   Margin="30,0,0,0"
                                   Foreground="{DynamicResource Bad}"
                                   IsVisible="{Binding ActiveIsLocked}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="9" IsVisible="{Binding MayManage}">
                        <Button Classes="primary" Content="Save" MinHeight="42" MinWidth="120"
                                IsEnabled="{Binding !Busy}"
                                Command="{Binding SaveCommand}" />
                        <Button Content="Cancel" MinHeight="42" Command="{Binding CancelCommand}" />
                        <!-- Disabled, not merely refused on being pressed. The
                             reason it cannot be used is printed beside the tick
                             above; a button that looks live and does nothing
                             makes that explanation look like it is about
                             something else. -->
                        <Button Content="{Binding Selected.ToggleWord}" MinHeight="42"
                                IsVisible="{Binding Resetting}"
                                IsEnabled="{Binding MayChangeActive}"
                                Command="{Binding ToggleActiveCommand}" />
                    </StackPanel>

                    <!-- ==================================== resetting a password -->
                    <StackPanel Spacing="12" IsVisible="{Binding Resetting}">
                        <Rectangle Height="1" Fill="{DynamicResource Line}" />

                        <TextBlock Text="SET THEIR PASSWORD" Classes="label" />

                        <TextBlock Classes="faint" FontSize="11" TextWrapping="Wrap"
                                   Text="The only way a forgotten password is recovered here. Type your own as well — a session somebody walked away from is otherwise a way into every account in the library." />

                        <StackPanel Spacing="6">
                            <TextBlock Text="Their new password" Classes="faint" />
                            <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"
                                     PasswordChar="•" MinHeight="40" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Your password" Classes="faint" />
                            <TextBox Text="{Binding AdminPassword, UpdateSourceTrigger=PropertyChanged}"
                                     PasswordChar="•" MinHeight="40" />
                        </StackPanel>

                        <Button Content="Reset the password" MinHeight="42" HorizontalAlignment="Left"
                                IsEnabled="{Binding !Busy}"
                                Command="{Binding ResetPasswordCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
          </Panel>
        </Border>
    </Grid>
</UserControl>
