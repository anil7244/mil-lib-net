<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MilLib.Desktop.ViewModels"
        xmlns:local="using:MilLib.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="620"
        x:Class="MilLib.Desktop.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Icon="/Assets/library.ico"
        Title="Library Management System"
        Width="840" Height="548"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:LoginViewModel />
    </Design.DataContext>

    <!--
        The same sign-in screen as the web application's, deliberately.

        Somebody who has been using mil-lib in a browser should not have to
        learn a second front door. So the layout, the wording and the palette
        are the web one's: the two-panel card, the unit on the left and the
        form on the right, the accent hairline over the crest, the licence line
        under the button.

        The colours are written here rather than taken from the application
        theme, for the same reason the web keeps its own auth tokens: this
        screen is dark whatever the rest of the application is set to, because
        it is the one screen seen before anybody has chosen anything.
    -->
    <!--
        The sign-in palette, now per theme like the web application's auth
        tokens. Dark is the original near-black; light is the web app's warm
        cream with slate ink. The screen follows whichever theme the unit has
        chosen, applied as the branding loads.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AuthText" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AuthHeading2" Color="#D9FFFFFF" />
                    <SolidColorBrush x:Key="AuthMuted" Color="#6BFFFFFF" />
                    <SolidColorBrush x:Key="AuthFaint" Color="#40FFFFFF" />
                    <SolidColorBrush x:Key="AuthGhost" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="AuthHairline" Color="#0FFFFFFF" />
                    <SolidColorBrush x:Key="AuthPanel" Color="#05FFFFFF" />
                    <SolidColorBrush x:Key="AuthPanel2" Color="#08FFFFFF" />
                    <SolidColorBrush x:Key="AuthInputBg" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="AuthInputBorder" Color="#1AFFFFFF" />
                    <LinearGradientBrush x:Key="AuthBackdrop" StartPoint="10%,0%" EndPoint="90%,100%">
                        <GradientStop Offset="0" Color="#0A0A0A" />
                        <GradientStop Offset="0.4" Color="#1A1A1A" />
                        <GradientStop Offset="1" Color="#111111" />
                    </LinearGradientBrush>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AuthText" Color="#17233A" />
                    <SolidColorBrush x:Key="AuthHeading2" Color="#B817233A" />
                    <SolidColorBrush x:Key="AuthMuted" Color="#64748B" />
                    <SolidColorBrush x:Key="AuthFaint" Color="#94A3B8" />
                    <SolidColorBrush x:Key="AuthGhost" Color="#2E0F172A" />
                    <SolidColorBrush x:Key="AuthHairline" Color="#1F3C321E" />
                    <SolidColorBrush x:Key="AuthPanel" Color="#053C321E" />
                    <SolidColorBrush x:Key="AuthPanel2" Color="#FCFBF7" />
                    <SolidColorBrush x:Key="AuthInputBg" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AuthInputBorder" Color="#290F172A" />
                    <LinearGradientBrush x:Key="AuthBackdrop" StartPoint="10%,0%" EndPoint="90%,100%">
                        <GradientStop Offset="0" Color="#EFEDE3" />
                        <GradientStop Offset="0.45" Color="#F7F6F0" />
                        <GradientStop Offset="1" Color="#F5F4EE" />
                    </LinearGradientBrush>
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <!-- The card rises once, in under half a second. An animation a person
             notices twice is too slow, and this screen is seen daily. -->
        <Style Selector="Border.entry">
            <Style.Animations>
                <Animation Duration="0:0:0.45" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- The fields, as the web draws them: flat, thin-bordered, square,
             and taking the accent when they have the cursor. -->
        <Style Selector="TextBox.auth">
            <Setter Property="Foreground" Value="{DynamicResource AuthText}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AuthText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="13,9" />
            <Setter Property="MinHeight" Value="38" />
        </Style>

        <Style Selector="TextBox.auth /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource AuthInputBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AuthInputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <Style Selector="TextBox.auth:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource AuthInputBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AuthGhost}" />
        </Style>

        <Style Selector="TextBox.auth:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#24C0392B" />
            <Setter Property="BorderBrush" Value="#C0392B" />
        </Style>

        <!-- Small, wide-tracked, upper case: the register the whole screen is
             written in. -->
        <Style Selector="TextBlock.authLabel">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AuthMuted}" />
        </Style>

        <Style Selector="Button.auth">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1.5" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.auth /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <Style Selector="CheckBox.auth">
            <Setter Property="Foreground" Value="{DynamicResource AuthMuted}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <!-- The two buttons on the bottom bar. LOGIN takes the unit's accent;
             RESET is a plain grey beside it — present, but plainly the lesser of
             the two, the way the reference draws them. -->
        <Style Selector="Button.act">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.act /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="3" />
        </Style>

        <Style Selector="Button.reset">
            <Setter Property="Background" Value="#6B7280" />
        </Style>

        <Style Selector="Button.reset:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#565E6B" />
        </Style>
    </Window.Styles>

    <Panel Background="{DynamicResource AuthBackdrop}">

        <Grid RowDefinitions="Auto,*,Auto">

            <!-- ============================================= the top strip -->
            <!-- The unit's bar, the same one the application carries once it is
                 signed in: the clock and date at the left, who the machine is for
                 at the right. The theme is chosen only from inside the
                 application, so there is no switch here — the front door simply
                 wears whichever theme was chosen. -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BarBg}"
                    BorderBrush="{Binding Accent}"
                    BorderThickness="0,0,0,3"
                    Padding="22,8">
                <Grid ColumnDefinitions="*,Auto">

                    <StackPanel Grid.Column="0" Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Clock}" FontSize="18" FontWeight="SemiBold"
                                   FontFamily="Segoe UI, Inter, sans-serif"
                                   Foreground="{DynamicResource BarInk}" />
                        <TextBlock Text="{Binding ClockDate}" FontSize="9.5" LetterSpacing="1.2"
                                   FontFamily="Segoe UI, Inter, sans-serif"
                                   Foreground="{DynamicResource BarInkSoft}" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="AUTHORISED PERSONNEL ONLY"
                               FontSize="10.5" FontWeight="Bold" LetterSpacing="1.5"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource BarInkSoft}" />
                </Grid>
            </Border>

            <!-- ================================================== the body -->
            <Grid Grid.Row="1" ColumnDefinitions="1.05*,1*">

                <!-- ============================== the unit's side -->
                <Border Grid.Column="0"
                        Background="{DynamicResource AuthPanel}"
                        BorderBrush="{DynamicResource AuthHairline}"
                        BorderThickness="0,0,1,0"
                        Padding="40,22">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                        <!-- The crest, given room to be seen: it is the unit's
                             own badge and the first thing anybody recognises. -->
                        <Border Width="132" Height="132" CornerRadius="999"
                                HorizontalAlignment="Center"
                                Background="{Binding CrestGround}"
                                BorderBrush="{Binding CrestEdge}"
                                BorderThickness="2"
                                ClipToBounds="True"
                                Margin="0,0,0,16">
                            <!-- A unit's crest is a large, detailed scan shown
                                 small. Downscaled with the default sampler it comes
                                 out rough; high-quality interpolation resamples it
                                 so a 2 MB badge reads crisp. -->
                            <Image Source="{Binding Crest}" Stretch="Uniform" Margin="8"
                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                        </Border>

                        <!-- The product leads, so anybody at the terminal sees
                             the system first. -->
                        <TextBlock Text="{Binding LibraryName}"
                                   FontSize="21" FontWeight="ExtraBold"
                                   LetterSpacing="1.8" LineHeight="26"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AuthText}" />

                        <TextBlock Text="{Binding Version}"
                                   FontSize="8.5" FontWeight="Bold" LetterSpacing="2"
                                   TextAlignment="Center" Margin="0,5,0,0"
                                   Foreground="{Binding Accent}" />

                        <Rectangle Width="40" Height="2" Margin="0,13"
                                   HorizontalAlignment="Center"
                                   Fill="{Binding Accent}" />

                        <!-- The unit and its motto: the second identity, under
                             the product's. -->
                        <StackPanel Orientation="Horizontal" Spacing="5"
                                    HorizontalAlignment="Center"
                                    IsVisible="{Binding HasOrganisation}">
                            <TextBlock Text="DEPLOYED FOR"
                                       FontSize="9.5" FontWeight="SemiBold" LetterSpacing="1.8"
                                       Foreground="{DynamicResource AuthMuted}" />
                            <TextBlock Text="{Binding Organisation}"
                                       FontSize="9.5" FontWeight="ExtraBold" LetterSpacing="2.2"
                                       Foreground="{DynamicResource AuthHeading2}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Motto}"
                                   IsVisible="{Binding HasMotto}"
                                   FontSize="9.5" FontWeight="SemiBold" LetterSpacing="2.6"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource AuthFaint}" />
                    </StackPanel>
                </Border>

                <!-- ==================================== the form -->
                <Border Grid.Column="1"
                        Background="{DynamicResource AuthPanel2}"
                        Padding="40,22">
                    <StackPanel VerticalAlignment="Center" MaxWidth="360">

                        <TextBlock Text="AUTHENTICATION REQUIRED"
                                   FontSize="15.5" FontWeight="ExtraBold" LetterSpacing="0.4"
                                   Foreground="{DynamicResource AuthText}" />
                        <Rectangle Height="3" Width="140" Margin="0,8,0,22"
                                   HorizontalAlignment="Left"
                                   Fill="{Binding Accent}" />

                        <!-- Said before anything else, because there is nothing to
                             sign in to without it. -->
                        <Border IsVisible="{Binding DataFileMissing}"
                                Background="#24C0392B"
                                BorderBrush="{Binding Accent}" BorderThickness="1"
                                Padding="11,9" Margin="0,0,0,14">
                            <StackPanel Spacing="3">
                                <TextBlock Text="The data file could not be found"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AuthText}" />
                                <SelectableTextBlock Text="{Binding DataFile}"
                                                     FontFamily="Consolas" FontSize="10"
                                                     TextWrapping="Wrap"
                                                     Foreground="{DynamicResource AuthMuted}" />
                            </StackPanel>
                        </Border>

                        <!-- The locked state, said before the fields — because
                             with the trial run out there is no point typing a
                             password, only a key. -->
                        <Border IsVisible="{Binding Locked}"
                                Background="#24C0392B"
                                BorderBrush="{Binding Accent}" BorderThickness="1"
                                Padding="13,11" Margin="0,0,0,16">
                            <StackPanel Spacing="9">
                                <TextBlock Text="This copy is locked"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource AuthText}" />
                                <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="17"
                                           Foreground="{DynamicResource AuthMuted}"
                                           Text="The trial or licence has ended. Enter a licence key to unlock it — nothing has been lost, and every record is still here." />
                                <Button Classes="auth" IsDefault="True"
                                        Background="{Binding Accent}"
                                        HorizontalAlignment="Left" MinWidth="180"
                                        Command="{Binding EnterKeyCommand}"
                                        AutomationProperties.Name="Enter licence key">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Data="{StaticResource IconLicence}"
                                              Fill="#FFFFFF" Stretch="Uniform" Width="13" Height="13"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="ENTER LICENCE KEY" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="USER NAME" Classes="authLabel" Margin="0,0,0,5" />
                        <TextBox Name="UsernameBox" Classes="auth"
                                 Watermark="Enter your user name"
                                 Margin="0,0,0,16"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="PASSWORD" Classes="authLabel" Margin="0,0,0,5" />
                        <TextBox Name="PasswordBox" Classes="auth"
                                 Watermark="Enter password"
                                 PasswordChar="•"
                                 Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- In the flow rather than floated over the fields, so
                             nothing jumps when it appears. -->
                        <Border IsVisible="{Binding HasProblem}"
                                Background="#24C0392B"
                                BorderBrush="{Binding Accent}" BorderThickness="1"
                                Padding="11,8" Margin="0,16,0,0">
                            <TextBlock Text="{Binding Problem}" FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource AuthText}" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============================================ the action bar -->
            <!-- Along the foot, the reference's kiosk footer: what the machine is
                 on the left — that it is sealed off from any network, and how its
                 licence stands — and the two things to do about the form on the
                 right. -->
            <Border Grid.Row="2"
                    Background="{DynamicResource AuthPanel}"
                    BorderBrush="{DynamicResource AuthHairline}"
                    BorderThickness="0,1,0,0"
                    Padding="22,10">
                <Grid ColumnDefinitions="*,Auto">

                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Data="{StaticResource IconLicence}"
                                  Fill="{Binding Accent}"
                                  Stretch="Uniform" Width="12" Height="12"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="FULLY OFFLINE · 0% INTERNET DEPENDENCIES"
                                       FontSize="10" FontWeight="Bold" LetterSpacing="0.6"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Accent}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="20,0,0,0"
                                    IsVisible="{Binding HasLicence}">
                            <TextBlock Text="{Binding Licence}" FontSize="10"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AuthMuted}" />
                            <TextBlock Text="·" FontSize="10" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AuthFaint}" />
                            <TextBlock Text="{Binding VendorLine}" FontSize="10"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AuthFaint}" />
                            <TextBlock Text="·" FontSize="10" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AuthFaint}" />
                            <Button Classes="link" Padding="0" MinHeight="0"
                                    VerticalAlignment="Center"
                                    Command="{Binding EnterKeyCommand}">
                                <TextBlock Text="Enter licence key" FontSize="10"
                                           TextDecorations="Underline"
                                           Foreground="{Binding Accent}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                VerticalAlignment="Center">
                        <Button Classes="act reset"
                                Command="{Binding ResetCommand}"
                                AutomationProperties.Name="Reset">
                            <TextBlock Text="RESET" VerticalAlignment="Center" />
                        </Button>

                        <Button Classes="act" IsDefault="True"
                                Background="{Binding Accent}"
                                IsEnabled="{Binding !Busy}"
                                Command="{Binding EnterCommand}"
                                AutomationProperties.Name="Login">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="LOGIN" VerticalAlignment="Center" />
                                <Path Data="{StaticResource IconSignIn}"
                                      Stroke="#FFFFFF" StrokeThickness="1.8"
                                      Stretch="Uniform" Width="14" Height="14"
                                      VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Panel>
</Window>
