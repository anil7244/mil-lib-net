<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MilLib.Desktop.ViewModels"
             xmlns:conv="using:MilLib.Desktop"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="MilLib.Desktop.Views.ActivityView"
             x:DataType="vm:ActivityViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,14">
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Search what was done — a username, an accession number, a word from an entry"
                     MinHeight="42" FontSize="14" Padding="14,9" />

            <Grid ColumnDefinitions="Auto,10,220,10,Auto,10,170,10,Auto,10,170,*">
                <ComboBox Grid.Column="0" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}"
                          MinHeight="38" MinWidth="170">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={x:Static conv:Spoken.Instance}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox Grid.Column="2" ItemsSource="{Binding People}" SelectedItem="{Binding Who}"
                          MinHeight="38" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:WhoRow">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Column="4" Text="from" Classes="faint"
                           VerticalAlignment="Center" Margin="4,0,0,0" />
                <!-- DateTime, not DateTimeOffset: the picker's own property is
                     DateTime?, and binding the other one throws where the date
                     should be. -->
                <CalendarDatePicker Grid.Column="6" SelectedDate="{Binding Since}"
                                    MinHeight="38" HorizontalAlignment="Stretch" />

                <TextBlock Grid.Column="8" Text="to" Classes="faint"
                           VerticalAlignment="Center" Margin="4,0,0,0" />
                <CalendarDatePicker Grid.Column="10" SelectedDate="{Binding Until}"
                                    MinHeight="38" HorizontalAlignment="Stretch" />

                <Button Grid.Column="11" Content="Clear" Classes="quiet" MinHeight="38"
                        HorizontalAlignment="Left" Margin="10,0,0,0"
                        Command="{Binding ClearCommand}" />
            </Grid>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding Tally}" Classes="faint" Margin="2,0,0,10" />

        <Border Grid.Row="2" Classes="card bad" IsVisible="{Binding HasProblem}"
                VerticalAlignment="Top" Padding="18,14">
            <TextBlock Text="{Binding Problem}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Bad}" />
        </Border>

        <Border Grid.Row="2" Classes="card" Padding="0" ClipToBounds="True"
                IsVisible="{Binding !HasProblem}">
            <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0" Classes="tableHead">
                    <Grid ColumnDefinitions="112,215,*" Margin="20,0">
                        <TextBlock Grid.Column="0" Text="WHEN" Classes="label" />
                        <TextBlock Grid.Column="1" Text="WHO" Classes="label" />
                        <TextBlock Grid.Column="2" Text="WHAT" Classes="label" />
                    </Grid>
                </Border>

                <Panel Grid.Row="1">
                    <StackPanel VerticalAlignment="Center" Spacing="8" Margin="30"
                                IsVisible="{Binding Nothing}">
                        <Path Classes="icon big" Data="{StaticResource IconActivity}"
                              Stroke="{DynamicResource InkFaint}" HorizontalAlignment="Center" />
                        <TextBlock Text="Nothing matches" Classes="sub" TextAlignment="Center" />
                    </StackPanel>

                    <ListBox Classes="table" ItemsSource="{Binding Entries}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             IsVisible="{Binding !Nothing}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:HappeningRow">
                                <Grid ColumnDefinitions="112,215,*" Margin="20,9">
                                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                                        <!-- The date only on the first entry of a
                                             day. Repeated two hundred times it is
                                             a column nobody reads; written once it
                                             marks where each day begins. -->
                                        <TextBlock Text="{Binding Day}" FontSize="11"
                                                   Classes="faint"
                                                   IsVisible="{Binding StartsADay}" />
                                        <TextBlock Text="{Binding Time}" Classes="mono" FontSize="12" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding Who}"
                                               VerticalAlignment="Center" Margin="0,0,12,0"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Column="2" Text="{Binding Said}"
                                               VerticalAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{Binding Notable, Converter={x:Static conv:Swatch.BadOrPlain}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Panel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="9" Margin="0,14,0,0">
            <Button Content="Newer" MinHeight="38" MinWidth="110"
                    IsEnabled="{Binding MayGoBack}"
                    Command="{Binding NewerCommand}" />
            <Button Content="Older" MinHeight="38" MinWidth="110"
                    IsEnabled="{Binding MayGoOn}"
                    Command="{Binding OlderCommand}" />
            <TextBlock Classes="faint" VerticalAlignment="Center" Margin="8,0,0,0"
                       Text="Nothing on this screen can be edited or removed — by anybody, in either program." />
        </StackPanel>
    </Grid>
</UserControl>
