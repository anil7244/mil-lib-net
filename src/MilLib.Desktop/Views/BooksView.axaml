<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MilLib.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="MilLib.Desktop.Views.BooksView"
             x:DataType="vm:BooksViewModel">

    <UserControl.Styles>
        <!-- The view switch: two square segments in one bordered box, the
             showing one filled with the unit's accent. -->
        <Style Selector="Border.seg">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background" Value="{DynamicResource Glass}" />
        </Style>
        <Style Selector="Button.seg">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.seg /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.seg:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource GlassRaised}" />
        </Style>
        <Style Selector="Button.seg.on /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="Button.seg Path">
            <Setter Property="Stroke" Value="{DynamicResource InkMuted}" />
        </Style>
        <Style Selector="Button.seg.on Path">
            <Setter Property="Stroke" Value="#FFFFFF" />
        </Style>

        <!-- The cover wall. The list itself sits on nothing, each book is a
             cell of a fixed width, and the one selected takes an accent ring
             rather than the filled row a table would draw. -->
        <Style Selector="ListBox.covers">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="22,20" />
        </Style>
        <Style Selector="ListBox.covers ListBoxItem">
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="0,0,16,20" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ListBox.covers ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource GlassRaised}" />
        </Style>
        <Style Selector="ListBox.covers ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>

        <!-- The cover, framed and lifted off the page. -->
        <Style Selector="Border.coverframe">
            <Setter Property="BoxShadow" Value="0 4 14 0 #26000000" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- One box, and what it found. Searching is the only thing anybody
             does on this screen often enough to deserve the width. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,18">
            <StackPanel Grid.Column="0" Spacing="6">
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Search by title, author, publisher, call number or accession number"
                         MinHeight="42"
                         FontSize="14"
                         Padding="14,9" />
                <TextBlock Text="{Binding Tally}" Classes="faint" Margin="3,0,0,0" />
            </StackPanel>

            <!-- Table or covers, the same books either way. -->
            <Border Grid.Column="1" Classes="seg" Height="42"
                    Margin="14,0,0,0" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <Button Classes="seg" Classes.on="{Binding TableView}"
                            Command="{Binding UseTableCommand}"
                            ToolTip.Tip="Show as a table">
                        <Path Data="{StaticResource IconRows}" StrokeThickness="1.8"
                              Width="17" Height="17" Stretch="Uniform" />
                    </Button>
                    <Button Classes="seg" Classes.on="{Binding CoversView}"
                            Command="{Binding UseCoversCommand}"
                            ToolTip.Tip="Show the covers">
                        <Path Data="{StaticResource IconGrid}" StrokeThickness="1.6"
                              Width="17" Height="17" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                        Margin="14,0,0,0" VerticalAlignment="Top">
                <!-- A double-click on the row does the same thing. The button is
                     here because a double-click is not discoverable, and this
                     screen is used by people nobody trained. -->
                <Button Classes="primary withIcon" Content="Open"
                        Tag="{StaticResource IconBooks}" MinHeight="42"
                        IsEnabled="{Binding HasSelection}"
                        Command="{Binding OpenSelectedCommand}" />
                <Button Content="Edit" MinHeight="42"
                        IsVisible="{Binding MayCatalogue}"
                        IsEnabled="{Binding HasSelection}"
                        Command="{Binding EditSelectedCommand}" />
                <Button Classes="withIcon" Content="Catalogue a book"
                        Tag="{StaticResource IconAdd}" MinHeight="42"
                        IsVisible="{Binding MayCatalogue}"
                        Command="{Binding AddCommand}" />
                <Button Classes="quiet" Content="Refresh" MinHeight="42"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Classes="card bad" IsVisible="{Binding HasProblem}"
                VerticalAlignment="Top" Padding="18,14">
            <TextBlock Text="{Binding Problem}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Bad}" />
        </Border>

        <!-- ===================================================== table view -->
        <Border Grid.Row="1" Classes="card" Padding="0" ClipToBounds="True"
                IsVisible="{Binding TableView}">
            <Grid RowDefinitions="Auto,*" IsVisible="{Binding !HasProblem}">

                <Border Grid.Row="0" Classes="tableHead">
                    <Grid ColumnDefinitions="54,2.8*,1.8*,1.4*,90,130,90,110" Margin="20,0">
                        <TextBlock Grid.Column="0" Text="COVER" Classes="label" />
                        <TextBlock Grid.Column="1" Text="TITLE" Classes="label" />
                        <TextBlock Grid.Column="2" Text="AUTHOR" Classes="label" />
                        <TextBlock Grid.Column="3" Text="PUBLISHER" Classes="label" />
                        <TextBlock Grid.Column="4" Text="LANGUAGE" Classes="label" />
                        <TextBlock Grid.Column="5" Text="ACCESSION NO" Classes="label" />
                        <TextBlock Grid.Column="6" Text="CALL NO" Classes="label" />
                        <TextBlock Grid.Column="7" Text="COPIES" Classes="label" />
                    </Grid>
                </Border>

                <!--
                     A ListBox rather than an ItemsControl in a ScrollViewer.

                     Fourteen hundred rows are only drawn a screenful at a time
                     this way. Laid out all at once the screen takes a visible
                     second to appear and scrolls unevenly afterwards.
                -->
                <ListBox Grid.Row="1" Classes="table"
                         ItemsSource="{Binding Shown}"
                         SelectedItem="{Binding Selected}"
                         DoubleTapped="OnRowActivated"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:BookRow">
                            <Grid ColumnDefinitions="54,2.8*,1.8*,1.4*,90,130,90,110" Margin="20,8">

                                <!-- The cover, small. It says at a glance which
                                     books have one and which are still blank,
                                     and a click opens it at full size. A book
                                     with none shows a spine mark, not an empty
                                     grey box. -->
                                <Border Grid.Column="0" Width="34" Height="46"
                                        Margin="0,0,14,0" CornerRadius="3"
                                        ClipToBounds="True" VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Cursor="Hand" Tapped="OnCoverTapped"
                                        Background="{DynamicResource SurfaceSunken}"
                                        BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                        ToolTip.Tip="Click to enlarge">
                                    <Panel>
                                        <Path Classes="icon" Data="{StaticResource IconBooks}"
                                              Stroke="{DynamicResource InkFaint}"
                                              Width="14" Height="14"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsVisible="{Binding !HasCover}" />
                                        <Image Source="{Binding Cover}" Stretch="UniformToFill"
                                               IsVisible="{Binding HasCover}" />
                                    </Panel>
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,14,0"
                                            VerticalAlignment="Center">
                                    <Grid ColumnDefinitions="Auto,Auto,*">
                                        <!-- A classified book says so on the row
                                             itself. Finding out at the counter,
                                             with the member standing there, is
                                             too late. -->
                                        <Border Grid.Column="0" Classes="pill warn"
                                                IsVisible="{Binding IsClassified}"
                                                Margin="0,0,8,0">
                                            <TextBlock Text="{Binding ClassificationText}" />
                                        </Border>
                                        <Border Grid.Column="1" Classes="pill info"
                                                IsVisible="{Binding UnitPublication}"
                                                Margin="0,0,8,0">
                                            <TextBlock Text="Unit pub" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Title}"
                                                   FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <TextBlock Text="{Binding Kind}" Classes="faint"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding Authors}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,14,0"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Column="3" Text="{Binding Publisher}"
                                           VerticalAlignment="Center" Classes="faint"
                                           Margin="0,0,14,0"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Column="4" Text="{Binding Language}"
                                           VerticalAlignment="Center" Classes="faint" />

                                <TextBlock Grid.Column="5" Text="{Binding Accession}"
                                           VerticalAlignment="Center" Classes="mono" />

                                <TextBlock Grid.Column="6" Text="{Binding CallNumber}"
                                           VerticalAlignment="Center" Classes="mono" />

                                <StackPanel Grid.Column="7" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding CopiesText}" FontWeight="Medium" />
                                    <TextBlock Text="{Binding AvailableText}"
                                               FontSize="11"
                                               Classes="faint" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1" IsVisible="{Binding Nothing}"
                            VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="Nothing matches that" Classes="h2"
                               HorizontalAlignment="Center" />
                    <TextBlock Classes="faint" HorizontalAlignment="Center"
                               Text="Try fewer words, or part of a word." />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================================================== cover view -->
        <Border Grid.Row="1" Classes="card" Padding="0" ClipToBounds="True"
                IsVisible="{Binding CoversView}">
            <Panel IsVisible="{Binding !HasProblem}">

                <!--
                     A wall of covers. A tap selects, a double-tap opens — the
                     same as a row — with the list's own selection lighting the
                     chosen cover's edge. A book with no cover yet shows a tidy
                     placeholder carrying its own title, so the wall reads as
                     books throughout rather than as gaps between the few scans.
                -->
                <ListBox Classes="covers"
                         ItemsSource="{Binding Shown}"
                         SelectedItem="{Binding Selected}"
                         DoubleTapped="OnRowActivated"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:BookRow">
                            <StackPanel Width="150" Spacing="9">

                                <Border Classes="coverframe" Height="206"
                                        CornerRadius="6" ClipToBounds="True"
                                        Background="{DynamicResource SurfaceSunken}"
                                        BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                    <Panel>
                                        <!-- placeholder -->
                                        <Border IsVisible="{Binding !HasCover}">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                    <GradientStop Offset="0" Color="{DynamicResource SurfaceColor}" />
                                                    <GradientStop Offset="1" Color="{DynamicResource SurfaceSunkenColor}" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <StackPanel VerticalAlignment="Center" Margin="14" Spacing="12">
                                                <Path Data="{StaticResource IconBooks}"
                                                      Stroke="{DynamicResource InkFaint}" StrokeThickness="1.4"
                                                      Width="26" Height="26" Stretch="Uniform"
                                                      HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding Title}" Classes="faint"
                                                           FontSize="12" FontWeight="Medium"
                                                           TextAlignment="Center" TextWrapping="Wrap"
                                                           MaxLines="4" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                        <Image Source="{Binding Cover}" Stretch="UniformToFill"
                                               IsVisible="{Binding HasCover}"
                                               RenderOptions.BitmapInterpolationMode="HighQuality" />

                                        <!-- a classified book is marked on the cover too -->
                                        <Border Classes="pill warn" IsVisible="{Binding IsClassified}"
                                                VerticalAlignment="Top" HorizontalAlignment="Left"
                                                Margin="6">
                                            <TextBlock Text="{Binding ClassificationText}" />
                                        </Border>
                                    </Panel>
                                </Border>

                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Title}" FontWeight="Medium"
                                               FontSize="12.5" LineHeight="16"
                                               TextWrapping="Wrap" MaxLines="2"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Authors}" Classes="faint"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel IsVisible="{Binding Nothing}"
                            VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="Nothing matches that" Classes="h2"
                               HorizontalAlignment="Center" />
                    <TextBlock Classes="faint" HorizontalAlignment="Center"
                               Text="Try fewer words, or part of a word." />
                </StackPanel>
            </Panel>
        </Border>
    </Grid>
</UserControl>
